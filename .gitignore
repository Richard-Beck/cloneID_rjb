# Local canonical inputs and generated analysis products
/core_data/*
!/core_data/README.md
/data/*
!/data/README.md

# Live lab-record knowledge base (durable locally, intentionally not versioned)
/lab_records/instance_protocol_db/

# Agent, hypothesis-test, and development run products
/tmp/
/.tmp/
/.cache/
/dev/
/hypothesis_tests/
/hypotheses/dev/
/deprecated_skills/
/candidate_workflows/

# Retain only the canonical hypothesis plan
/plans/*
!/plans/seed1_hypothesis_test_v3/
!/plans/seed1_hypothesis_test_v3/plan.json

# Superseded local protocol-extraction prototypes
/prompt_templates/labarchive_protocol_extraction.txt
/prompt_templates/protocol_rule_similarity_first_pass.txt
/scripts/analyze_protocol_rule_similarity.py
/scripts/plot_protocol_similarity_heatmap.R
/scripts/protocol_rule_similarity.py
/scripts/run_labarchive_protocol_extraction.sh
/scripts/run_protocol_rule_similarity.sh
/scripts/tests/test_protocol_rule_similarity.py

# Language and editor caches
**/__pycache__/
*.py[cod]
.DS_Store
.Rhistory
.Rproj.user/

# Portable PhysiCell example; all other development state remains local
!/dev/
/dev/*
!/dev/physicell_baseline/
/dev/physicell_baseline/*
!/dev/physicell_baseline/workflow.md
!/dev/physicell_baseline/mechanistic_model.md
!/dev/physicell_baseline/adaptation_proposal.md
!/dev/physicell_baseline/PhysiCell_settings.xml
!/dev/physicell_baseline/cell_rules.csv
!/dev/physicell_baseline/baseline_runtime.cpp

# Publishing assets and private source evidence never enter Git
/release-assets/
/_site/
/lab_records/instance_protocol_source_snapshots/
*.tar.gz.gpg
