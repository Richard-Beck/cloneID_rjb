{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "notebook_id",
    "compressed_text",
    "source_accounting",
    "quality_notes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "notebook_id": {
      "type": "string"
    },
    "compressed_text": {
      "type": "string",
      "minLength": 1
    },
    "source_accounting": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_spans", "disposition", "compressed_location", "rationale"],
        "properties": {
          "source_spans": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^S[0-9]{4}$"
            }
          },
          "disposition": {
            "type": "string",
            "enum": [
              "retained",
              "factored_definition",
              "collapsed_routine",
              "vendor_reference",
              "duplicate",
              "empty_placeholder"
            ]
          },
          "compressed_location": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "quality_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
